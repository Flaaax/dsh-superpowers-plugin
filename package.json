{
  "name": "dsh-superpowers-plugin",
  "version": "0.2.1",
  "description": "DeepSeek Harness native bundle for the Superpowers skill collection",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Flaaax/dsh-superpowers-plugin.git"
  },
  "homepage": "https://github.com/Flaaax/dsh-superpowers-plugin#readme",
  "bugs": {
    "url": "https://github.com/Flaaax/dsh-superpowers-plugin/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "skills/**",
    "scripts/**/*.mjs",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "upstream-lock.json",
    "README.md",
    "README.zh-CN.md",
    "NOTICE.md",
    "LICENSE",
    "LICENSE.superpowers"
  ],
  "scripts": {
    "test": "node --test",
    "verify:upstream": "node scripts/verify-upstream.mjs",
    "sync:upstream": "node scripts/sync-upstream.mjs"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "superpowers",
    "skills"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-rc.3",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.3",
    "react": "18.3.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-primitives": { "optional": true },
    "@deepseek-ai/dsh-client-ui-settings": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "react": { "optional": true }
  }
}
